{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#1ee105",
					"name": "vert-clair",
					"slug": "custom-vert-clair"
				},
				{
					"color": "#000",
					"name": "noir",
					"slug": "custom-noir"
				},
				{
					"color": "#ffe8b8",
					"name": "crème",
					"slug": "custom-cr-me"
				}
			]
		},
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1920px"
		},
		"shadow": {
			"defaultPresets": false
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "\"Harry P\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/harry-p/harry-p-400-normal.ttf"
							]
						}
					],
					"fontFamily": "\"Harry P\"",
					"name": "Harry P",
					"slug": "harry-p"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"elements": {
			"link": {
				":hover": {
					"color": {
						"text": "#345a7f"
					}
				},
				"color": {
					"text": "#000000"
				}
			}
		},
		"spacing": {
			"padding": {
				"bottom": "0px",
				"left": "2rem",
				"right": "2rem",
				"top": "0px"
			}
		}
	}
}