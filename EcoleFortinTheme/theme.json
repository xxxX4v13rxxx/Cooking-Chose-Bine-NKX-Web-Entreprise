{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#1e1610",
					"name": "Color 1",
					"slug": "custom-color-1"
				},
				{
					"color": "#d4af37",
					"name": "Color 2",
					"slug": "custom-color-2"
				},
				{
					"color": "#dfd7cc",
					"name": "Color 3",
					"slug": "custom-color-3"
				},
				{
					"color": "#668586",
					"name": "Color 4",
					"slug": "custom-color-4"
				},
				{
					"color": "#4e6b70",
					"name": "Color 5",
					"slug": "custom-color-5"
				},
				{
					"color": "#749596",
					"name": "Color 6",
					"slug": "custom-color-6"
				}
			]
		},
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1920px"
		},
		"shadow": {
			"defaultPresets": false
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFace": [
						{
							"fontFamily": "\"Instrument Sans\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-400-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Instrument Sans\"",
							"fontStyle": "normal",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-500-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Instrument Sans\"",
							"fontStyle": "normal",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-600-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Instrument Sans\"",
							"fontStyle": "normal",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-700-normal.woff2"
							]
						},
						{
							"fontFamily": "\"Instrument Sans\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-400-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Instrument Sans\"",
							"fontStyle": "italic",
							"fontWeight": "500",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-500-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Instrument Sans\"",
							"fontStyle": "italic",
							"fontWeight": "600",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-600-italic.woff2"
							]
						},
						{
							"fontFamily": "\"Instrument Sans\"",
							"fontStyle": "italic",
							"fontWeight": "700",
							"src": [
								"file:./assets/fonts/instrument-sans/instrument-sans-700-italic.woff2"
							]
						}
					],
					"fontFamily": "\"Instrument Sans\", sans-serif",
					"name": "Instrument Sans",
					"slug": "instrument-sans"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--custom-color-5)",
			"text": "#ffffff"
		},
		"elements": {
			"link": {
				"color": {
					"text": "#ffffff"
				}
			}
		},
		"spacing": {
			"padding": {
				"bottom": "0px",
				"left": "0rem",
				"right": "0rem",
				"top": "0px"
			}
		}
	}
}